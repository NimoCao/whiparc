# Copy to .env.dev on the VM (git-ignored) and fill in every value. Used only by
# docker-compose.hosted-dev.yml, started with:
#   docker compose --env-file .env.dev -f docker-compose.hosted-dev.yml up -d
#
# Every secret here must differ from production's .env. Reusing a production
# JWT_SECRET would make dev-issued tokens valid against production, and reusing
# WHIPARC_MASTER_KEY would let one stack decrypt the other's stored credentials.
# Generate each with:  openssl rand -base64 32   (DEV_POSTGRES_PASSWORD: openssl rand -hex 24,
# hex only, because it is embedded in the DATABASE_URL)

# Password for the bundled dev Postgres container.
DEV_POSTGRES_PASSWORD=

# The only origin the dev API allows (CORS, WebSocket) and where OAuth and
# emailed links send the browser. Must be exactly the dev frontend.
FRONTEND_URL=https://dev.whiparc.com
API_PUBLIC_URL=https://dev-api.whiparc.com

JWT_SECRET=
WHIPARC_MASTER_KEY=

# Separate OAuth apps for dev. Callback URLs:
#   https://dev-api.whiparc.com/api/auth/google/callback
#   https://dev-api.whiparc.com/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Paddle sandbox only. A production key here would bill real cards from dev.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO=

# Optional: leave unset to print verification links to the API logs instead of
# sending mail from dev.
# RESEND_API_KEY=
# EMAIL_FROM=Whiparc Dev <noreply@whiparc.com>

# Optional: image tag to run (default: dev).
# API_IMAGE_TAG=
