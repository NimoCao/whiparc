# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
/sandbox/id_rsa
/sandbox/id_rsa.pub

# build
.turbo

# local dev builds
/apps/api/data
/apps/api/dev.db

# compiled CLI binaries (build outputs, not source)
/apps/cli/cli
/apps/cli/cli.exe
/apps/cli/dist/

# CLI binaries/installers build_cli_local.ps1 or CI drop here for local
# `/downloads` serving — build outputs, not source; CI attaches the real
# release copies to GitHub Releases instead of committing them here.
/apps/api/static/downloads/*
!/apps/api/static/downloads/.gitkeep

# internal Obsidian knowledge base: contains business-strategy and
# security-implementation notes not meant to ship in a public repo
/obsidian_memory/

# mcp for assistant
/.mcp*
