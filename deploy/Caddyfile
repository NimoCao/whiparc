# Reverse proxy for the Hetzner launch runbook (see the "Domain & DNS wiring"
# and "Deploy & wire DNS" sections). One box, one Caddy process, two site
# blocks (plus the dev-api block below) routing by hostname to
# docker-compose.hosted.yml's published ports —
# TLS is automatic (Caddy issues and renews Let's Encrypt certs per hostname
# on first request), no certbot cron job to maintain.
#
# Usage on the Hetzner VM, after `docker compose -f docker-compose.hosted.yml
# up -d` is running with ports 8080 (api) and 9090 (agent-gateway) published
# on localhost:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Requires DNS A records for both hostnames already pointing at this VM's
# public IP (see the runbook's DNS section) before Caddy can obtain certs.

api.whiparc.com {
	reverse_proxy localhost:8080
}

gateway.whiparc.com {
	reverse_proxy localhost:9090
}

# Dev backend (docker-compose.hosted-dev.yml, published on 127.0.0.1:8081).
# Needs its own DNS A record, `dev-api`, pointing at this VM like the two above.
dev-api.whiparc.com {
	reverse_proxy localhost:8081
}
